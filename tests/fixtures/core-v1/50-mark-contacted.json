            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond to Contact Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Lead Contacted": {
      "main": [
        [
          {
            "node": "Build Contact Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Contact Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Contact Response": {
      "main": [
        [
          {
            "node": "Respond to Contact Update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Contact Failure": {
      "main": [
        [
          {
