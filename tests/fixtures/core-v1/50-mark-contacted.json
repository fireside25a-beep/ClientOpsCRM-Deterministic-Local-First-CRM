{
  "id": "clr_contact_0001",
  "name": "ClientOps Relay — Mark Contacted",
  "active": false,
  "nodes": [
    {
      "id": "contact-webhook",
      "name": "Contacted Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        180
      ],
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "path": "clientops/leads/contacted",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "clientops-admin-api-key",
          "name": "ClientOps Admin API Key"
        }
      },
      "webhookId": "clientops-mark-contacted-v1"
    },
    {
      "id": "contact-validate",
      "name": "Validate Contact Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map((item) => {\n  const body = item.json?.body;\n  const errors = [];\n  if (!body || Array.isArray(body) || typeof body !== 'object') errors.push('body must be a JSON object');\n  if (body && typeof body === 'object') {\n    for (const key of Object.keys(body)) if (!['ticketId', 'note'].includes(key)) errors.push('unknown field: ' + key);\n    if (typeof body.ticketId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(body.ticketId)) errors.push('ticketId must be a UUID');\n    if (body.note !== undefined && (typeof body.note !== 'string' || body.note.length > 1000)) errors.push('note must be a string up to 1000 characters');\n  }\n  return errors.length\n    ? { json: { valid: false, statusCode: 422, response: { ok: false, error: { code: 'invalid_request', message: 'Request validation failed', details: errors } } } }\n    : { json: { valid: true, ticketId: body.ticketId, note: body.note ?? '' } };\n});"
      }
    },
    {
      "id": "contact-valid",
      "name": "Update Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "contact-valid-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "contact-store",
      "name": "Mark Lead Contacted",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        720,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT status_code AS \"statusCode\", outcome, public_message AS \"message\"\n       FROM clientops.mark_lead_contacted($1::uuid, $2);",
        "options": {
          "queryReplacement": "={{ [ $json.ticketId, $json.note ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "clientops-postgres",
          "name": "ClientOps PostgreSQL"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "contact-public",
      "name": "Build Contact Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map((item) => ({ json: {\n  statusCode: Number(item.json.statusCode),\n  response: Number(item.json.statusCode) === 404\n    ? { ok: false, error: { code: 'not_found', message: item.json.message } }\n    : { ok: true, outcome: item.json.outcome, message: item.json.message },\n}, pairedItem: item.pairedItem }));"
      }
    },
    {
      "id": "contact-unavailable",
      "name": "Build Contact Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map(() => ({ json: {\n  statusCode: 503,\n  response: { ok: false, error: { code: 'service_unavailable', message: 'Contact update is temporarily unavailable' } },\n} }));"
      }
    },
    {
      "id": "contact-respond",
      "name": "Respond to Contact Update",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1200,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.response }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    }
  ],
  "connections": {
    "Contacted Webhook": {
      "main": [
        [
          {
